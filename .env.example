# DEVELOPMENT ENVIRONMENT CONFIGURATION
NODE_ENV=development
PORT=5002

# Database Configuration
# Local MongoDB
MONGO_URI=mongodb://localhost:27017/spark
# OR MongoDB Atlas (for production)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/spark

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRE=30d
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# URLs for OAuth redirects and CORS
# Development: Use localhost URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5002

# Production URLs (uncomment for production)
# FRONTEND_URL=https://your-frontend-url.up.railway.app
# BACKEND_URL=https://your-backend-url.up.railway.app

# Integration credentials - Uncomment and fill in when needed
# Google Drive Integration
# GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret

# YouTube Integration
# YOUTUBE_CLIENT_ID=your-youtube-client-id
# YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Facebook/Instagram Integration
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: Serve frontend from backend (for single-domain deployment)
# SERVE_FRONTEND=true
